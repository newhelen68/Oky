# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================

# Puerto del servidor backend
PORT=5000

# Entorno de ejecución (development, production)
NODE_ENV=development

# ==============================================
# OPENAI API
# ==============================================

# Tu API Key de OpenAI (obligatoria)
# Obtén tu API Key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=OPENAI_API_KEY=TU_NUEVA_API_KEY

# Modelo para embeddings (text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelo para chat (gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo)
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Temperatura para respuestas del chat (0.0 - 2.0)
# 0.0 = más determinista, 2.0 = más creativo
OPENAI_TEMPERATURE=0.7

# Número máximo de tokens en la respuesta
OPENAI_MAX_TOKENS=1000

# ==============================================
# CONFIGURACIÓN DE ARCHIVOS
# ==============================================

# Tamaño máximo de archivo en bytes (10MB por defecto)
MAX_FILE_SIZE=10485760

# Tipos de archivo permitidos (separados por coma)
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.csv

# Directorio para almacenar archivos subidos
UPLOAD_DIR=./uploads

# ==============================================
# CONFIGURACIÓN DE PROCESAMIENTO
# ==============================================

# Tamaño de chunk en caracteres
CHUNK_SIZE=1000

# Overlap entre chunks en caracteres
CHUNK_OVERLAP=200

# Número de chunks relevantes a recuperar en búsqueda
TOP_K_RESULTS=5

# ==============================================
# CONFIGURACIÓN DE VECTORSTORE
# ==============================================

# Directorio para almacenar el índice de vectores
VECTORSTORE_DIR=./vectorstore

# Algoritmo de búsqueda FAISS (Flat, IVFFlat, HNSW)
FAISS_INDEX_TYPE=Flat

# ==============================================
# SEGURIDAD Y RATE LIMITING
# ==============================================

# Ventana de tiempo para rate limiting (en milisegundos)
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de peticiones por ventana
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# CORS
# ==============================================

# Origen permitido para CORS en producción
CORS_ORIGIN=https://tu-dominio.com

# ==============================================
# LOGGING
# ==============================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Directorio para logs
LOG_DIR=./logs

# Tamaño máximo de archivo de log en bytes
LOG_MAX_SIZE=5242880

# Número máximo de archivos de log a mantener
LOG_MAX_FILES=5

# ==============================================
# CONFIGURACIÓN CSV (NUEVA)
# ==============================================

# Delimitador por defecto para archivos CSV
CSV_DELIMITER=,

# Encoding para archivos CSV
CSV_ENCODING=utf-8

# Si debe incluir encabezados al procesar CSV
CSV_HAS_HEADERS=true

# Número máximo de filas a procesar por chunk en CSV
CSV_ROWS_PER_CHUNK=50
